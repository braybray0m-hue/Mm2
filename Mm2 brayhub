local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 12)
UICorner.Parent = MainFrame

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 40)
Title.BackgroundTransparency = 1
Title.Text = "MM2 Aim & ESP"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextSize = 16
Title.Font = Enum.Font.SourceSansBold
Title.Parent = MainFrame

local function createButton(name, position, text)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 35)
    btn.Position = position
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.Text = text .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    btn.Parent = MainFrame
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn
    return btn
end

local EspButton = createButton("EspButton", UDim2.new(0.05, 0, 0.3, 0), "Role ESP")
local LockButton = createButton("LockButton", UDim2.new(0.05, 0, 0.65, 0), "Target Lock")

-- States
local espEnabled = false
local lockEnabled = false
local highlights = {}

EspButton.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    EspButton.Text = "Role ESP: " .. (espEnabled and "ON" or "OFF")
    EspButton.BackgroundColor3 = espEnabled and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(60, 60, 60)
    if not espEnabled then
        for _, h in pairs(highlights) do h:Destroy() end
        highlights = {}
    end
end)

LockButton.MouseButton1Click:Connect(function()
    lockEnabled = not lockEnabled
    LockButton.Text = "Target Lock: " .. (lockEnabled and "ON" or "OFF")
    LockButton.BackgroundColor3 = lockEnabled and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(60, 60, 60)
end)

-- Helper to find Murderer or Sheriff based on carried tools (Knife/Gun)
local function getTargetPlayer()
    local target = nil
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local backpack = player:FindFirstChild("Backpack")
            local char = player.Character
            local hasKnife = (char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife")))
            local hasGun = (char:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun")))
            
            -- Prioritize Murderer (Knife), then Sheriff (Gun)
            if hasKnife then
                return char.HumanoidRootPart, Color3.fromRGB(255, 0, 0) -- Red for Murderer
            elseif hasGun and not target then
                target = char.HumanoidRootPart -- Fallback/Alternative role
            end
        end
    end
    return target, Color3.fromRGB(0, 0, 255)
end

RunService.RenderStepped:Connect(function()
    -- Role ESP Logic
    if espEnabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local char = player.Character
                if not highlights[player] then
                    local hl = Instance.new("Highlight")
                    hl.Parent = char
                    highlights[player] = hl
                end
                
                local backpack = player:FindFirstChild("Backpack")
                if char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife")) then
                    highlights[player].FillColor = Color3.fromRGB(255, 0, 0) -- Murderer
                elseif char:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun")) then
                    highlights[player].FillColor = Color3.fromRGB(0, 0, 255) -- Sheriff
                else
                    highlights[player].FillColor = Color3.fromRGB(0, 255, 0) -- Innocent
                end
            end
        end
    end

    -- Target Lock Logic
    if lockEnabled then
        local targetPart, _ = getTargetPlayer()
        if targetPart then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
        end
    end
end)
